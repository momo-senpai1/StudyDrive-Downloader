{
  "manifest_version": 3,
  "name": "StudyDrive Downloader Extension",
  "version": "1.2",
  "description": "A extension to download documents from StudyDrive for Mozarella.",
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "studydrive-downloader@example.com"
    }
  },
  "permissions": ["downloads"],
  "host_permissions": [
    "https://www.studydrive.net/*",
    "https://cdn.studydrive.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.studydrive.net/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
